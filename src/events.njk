---
title: Events
layout: layouts/base.njk
---
<h1>Events</h1>
<p>The club's yearly round, one gathering to a season.</p>

{% for event in collections.events %}
<div class="entry">
  <p class="entry-meta">{{ event.data.season }}</p>
  <h2>{{ event.data.title }}</h2>
  {{ event.templateContent | safe }}
</div>
{% endfor %}
